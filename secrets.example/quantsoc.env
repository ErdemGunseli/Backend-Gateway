# Example per-project secret file.
#
# In production this is a Render Secret File mounted at /etc/secrets/quantsoc.env
# and loaded into ONLY the quantsoc process. Never commit real secrets.
#
# For a sqlite-backed project the gateway sets DATABASE_URL itself (a file on the
# persistent disk), so it is intentionally omitted here. For a db = "external"
# project, include DATABASE_URL here instead.

HASH_KEY=replace-with-a-long-random-secret
HASH_ALGORITHM=HS256
TOKEN_TTL=30
REFRESH_TOKEN_TTL=43200
MIN_PASSWORD_LENGTH=8
MAX_PASSWORD_LENGTH=128
PASSWORD_STRENGTH_THRESHOLD=2
APP_DOMAIN=quantsoc.api.erdemgunseli.com
SENDER_NAME=QuantSoc
VERIFICATION_CODE_TTL=10
RESET_PASSWORD_CODE_TTL=15

# Email, OAuth, etc. as required by the project:
# EMAIL_PROVIDER=BREVO
# BREVO_API_KEY=...
# GOOGLE_CLIENT_ID=...
