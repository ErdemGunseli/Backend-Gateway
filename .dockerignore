# Only the gateway orchestrator and each project's backend reach the image.
.git
**/.git
generated/
secrets/
**/.venv/

# Frontends and their build output never run in the gateway.
projects/*/next-pwa/
projects/*/react-extension/
projects/*/frontend/
**/node_modules/
**/.next/
**/dist/
**/build/

# Local cruft.
**/__pycache__/
**/*.pyc
**/.DS_Store
**/.vscode/
**/*.log
